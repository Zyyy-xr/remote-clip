3、OpenCode配置文件示例（近期发现老版本如1.16.x 有兼容性问题，请升级到最新版本后使用，8月时最新版本号为1.18.x）
蓝区配置文件参考：https://gitcode.com/Operations_Blue/config/blob/main/AI%E7%BD%91%E5%85%B3_opencode.jsonc
使用文本编辑器打开：
macOS / Linux：~/.config/opencode/opencode.json或~/.config/opencode/opencode.jsonc
Windows：C:\Users\<用户名>\.config\opencode\opencode.json或C:\Users\<用户名>\.config\opencode\opencode.jsonc

{
	"$schema": "https://opencode.ai/config.json",
	"disabled_providers": [],
	"provider": {
		"gateway": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "AI网关",
			"options": {
				"baseURL": "https://st8tp3ajl0df3n8b8l8qu.apigateway-cn-beijing.volceapi.com/v1",
				"apiKey": "输入你自己的apiKey"
			},
			"models": {
				"deepseek-v4-pro": {
					"name": "DeepSeek V4 Pro"
				},
				"deepseek-v4-flash": {
					"name": "DeepSeek V4 Flash"
				},
				"doubao-seed-2.1-pro": {
					"name": "Doubao Seed 2.1 Pro"
				},
				"glm-5.2": {
					"name": "GLM 5.2"
				},
				"glm-5.3": {
					"name": "GLM-5.3",
					"maxInputTokens": 256000,
					"maxOutputTokens": 8192,
					"modalities": {
						"input": ["text"],
						"output": ["text"]
					},
					"thinking": {
						"type": "enabled"
					},
					"reasoning_effort": "high"   // low-轻量推理；high-增强推理；max-深度推理
				},
				"glm-5.3-flash": {
					"name": "GLM-5.3 Flash",
					"maxInputTokens": 256000,
					"maxOutputTokens": 8192,
					"modalities": {
						"input": ["text","image"],  // 输入图片前建议先将图片进行压缩
						"output": ["text"]
					},
					"attachment": true,
					"thinking": {
						"type": "enabled"
					},
					"reasoning_effort": "high"   // low-轻量推理；high-增强推理；max-深度推理
				},
				"qwen3.7-max": {
					"name": "Qwen3.7-Max"
				},
				"qwen3.7-plus": {
					"name": "Qwen3.7-Plus"
				},
				"MiniMax-M3": {
					"name": "MiniMax-M3"
				},
				"hy3": {
					"name": "Hy3"
				}
			}
		}
	}
}
